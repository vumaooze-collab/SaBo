"use strict";

/* =========================================================
   SaBo Sell Product
========================================================= */

const SUPABASE_URL =
  "https://xqmqgmeewnahrdzoiwyu.supabase.co";

const SUPABASE_PUBLISHABLE_KEY =
  "sb_publishable_HB8q-p6LCcM9fq6FgNlVgg_8zXEV3cI";

const supabaseClient =
  window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_PUBLISHABLE_KEY
  );

/* =========================================================
   DOM
========================================================= */

const elements = {
  form:
    document.getElementById("sellForm"),

  backButton:
    document.getElementById("backButton"),

  cancelButton:
    document.getElementById(
      "cancelButton"
    ),

  submitButton:
    document.getElementById(
      "submitButton"
    ),

  formMessage:
    document.getElementById(
      "formMessage"
    ),

  category:
    document.getElementById(
      "category"
    )
};

/* =========================================================
   Initialize
========================================================= */

async function initializeSellPage() {

  bindEvents();

  await loadCategories();
}

/* =========================================================
   Events
========================================================= */

function bindEvents() {

  elements.form?.addEventListener(
    "submit",
    handleSubmit
  );

  elements.backButton?.addEventListener(
    "click",
    goBack
  );

  elements.cancelButton?.addEventListener(
    "click",
    goBack
  );
}

/* =========================================================
   Navigation
========================================================= */

function goBack() {

  if (window.history.length > 1) {

    window.history.back();

  } else {

    window.location.href =
      "index.html";
  }
}

/* =========================================================
   Categories
========================================================= */

async function loadCategories() {

  const {
    data,
    error
  } = await supabaseClient
    .from("categories")
    .select("id,name")
    .order("name", {
      ascending: true
    });

  if (error) {

    console.error(
      "Category loading error:",
      error
    );

    showMessage(
      "Unable to load categories.",
      "error"
    );

    return;
  }

  const categories =
    data || [];

  categories.forEach(
    (category) => {

      const option =
        document.createElement("option");

      option.value =
        category.id;

      option.textContent =
        category.name;

      elements.category.appendChild(
        option
      );
    }
  );
}

/* =========================================================
   Form Submission
========================================================= */

async function handleSubmit(event) {

  event.preventDefault();

  clearMessage();

  const formData =
    new FormData(
      elements.form
    );

  const product =
    buildProductPayload(
      formData
    );

  const validation =
    validateProduct(product);

  if (!validation.valid) {

    showMessage(
      validation.message,
      "error"
    );

    return;
  }

  setSubmitting(true);

  const {
    data,
    error
  } = await supabaseClient
    .from("products")
    .insert(product)
    .select()
    .single();

  setSubmitting(false);

  if (error) {

    console.error(
      "Product creation error:",
      error
    );

    showMessage(
      getDatabaseErrorMessage(error),
      "error"
    );

    return;
  }

  showMessage(
    "Product published successfully.",
    "success"
  );

  /*
   * Give the user a moment to see
   * the success state before redirecting.
   */

  setTimeout(
    () => {

      window.location.href =
        `product.html?id=${encodeURIComponent(
          data.id
        )}`;

    },
    700
  );
}

/* =========================================================
   Build Database Payload
========================================================= */

function buildProductPayload(formData) {

  const price =
    Number(
      formData.get("price")
    );

  const stock =
    Number(
      formData.get("stock")
    );

  return {

    name:
      String(
        formData.get("name") || ""
      ).trim(),

    description:
      String(
        formData.get("description") || ""
      ).trim() || null,

    price,

    currency:
      "MWK",

    category_id:
      String(
        formData.get("category_id") || ""
      ).trim() || null,

    image_url:
      String(
        formData.get("image_url") || ""
      ).trim() || null,

    location:
      String(
        formData.get("location") || ""
      ).trim() || null,

    seller_name:
      String(
        formData.get("seller_name") || ""
      ).trim() || null,

    seller_phone:
      String(
        formData.get("seller_phone") || ""
      ).trim() || null,

    condition:
      String(
        formData.get("condition") || "new"
      ).trim(),

    stock,

    is_available:
      true,

    is_featured:
      false
  };
}

/* =========================================================
   Validation
========================================================= */

function validateProduct(product) {

  if (!product.name) {

    return {
      valid: false,
      message:
        "Please enter a product name."
    };
  }

  if (
    !Number.isFinite(product.price) ||
    product.price < 0
  ) {

    return {
      valid: false,
      message:
        "Please enter a valid price."
    };
  }

  if (
    !Number.isInteger(product.stock) ||
    product.stock < 1
  ) {

    return {
      valid: false,
      message:
        "Quantity must be at least 1."
    };
  }

  if (!product.category_id) {

    return {
      valid: false,
      message:
        "Please select a category."
    };
  }

  if (
    product.image_url &&
    !isValidUrl(
      product.image_url
    )
  ) {

    return {
      valid: false,
      message:
        "Please enter a valid image URL."
    };
  }

  return {
    valid: true
  };
}

/* =========================================================
   URL Validation
========================================================= */

function isValidUrl(value) {

  try {

    const url =
      new URL(value);

    return (
      url.protocol === "http:" ||
      url.protocol === "https:"
    );

  } catch {

    return false;
  }
}

/* =========================================================
   Submit State
========================================================= */

function setSubmitting(
  submitting
) {

  elements.submitButton.disabled =
    submitting;

  elements.cancelButton.disabled =
    submitting;

  elements.submitButton.textContent =
    submitting
      ? "Publishing..."
      : "Publish Product";
}

/* =========================================================
   Messages
========================================================= */

function showMessage(
  message,
  type
) {

  elements.formMessage.textContent =
    message;

  elements.formMessage.className =
    `form-message show ${type}`;
}

function clearMessage() {

  elements.formMessage.textContent =
    "";

  elements.formMessage.className =
    "form-message";
}

/* =========================================================
   Database Errors
========================================================= */

function getDatabaseErrorMessage(
  error
) {

  if (
    error?.code === "23505"
  ) {
    return "This product already exists.";
  }

  if (
    error?.code === "23503"
  ) {
    return "The selected category is invalid.";
  }

  if (
    error?.code === "42501"
  ) {
    return "You do not have permission to publish products.";
  }

  return (
    error?.message ||
    "Unable to publish the product."
  );
}

/* =========================================================
   Start
========================================================= */

initializeSellPage();
