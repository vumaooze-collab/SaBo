<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>SaBo — Create Account</title>

  <link rel="stylesheet" href="style.css">

  <style>
    .auth-page {
      width: min(
        calc(100% - 28px),
        480px
      );

      margin: 60px auto;
    }

    .auth-card {
      padding: 30px;

      background: white;

      border: 1px solid #eadfca;
      border-radius: 16px;

      box-shadow:
        0 8px 25px rgba(0, 0, 0, 0.07);
    }

    .auth-card h1 {
      margin-bottom: 8px;
      font-size: 32px;
    }

    .auth-subtitle {
      margin-bottom: 28px;
      color: #777;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 7px;
      font-weight: 800;
    }

    .form-group input {
      width: 100%;

      padding: 14px;

      border: 1px solid #d8cdb8;
      border-radius: 9px;

      outline: none;
    }

    .form-group input:focus {
      border-color: #f57c00;

      box-shadow:
        0 0 0 3px
        rgba(245, 124, 0, 0.12);
    }

    .auth-submit {
      width: 100%;

      min-height: 50px;

      border-radius: 9px;

      background: #f57c00;
      color: white;

      font-weight: 900;

      cursor: pointer;
    }

    .auth-submit:hover {
      background: #df6d00;
    }

    .auth-submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .auth-link {
      margin-top: 20px;

      text-align: center;

      color: #777;
    }

    .auth-link a {
      color: #f57c00;
      font-weight: 800;
    }

    .auth-message {
      display: none;

      margin-bottom: 18px;
      padding: 12px;

      border-radius: 8px;

      font-weight: 700;
    }

    .auth-message.show {
      display: block;
    }

    .auth-message.error {
      background: #ffebee;
      color: #c62828;
    }

    .auth-message.success {
      background: #e8f5e9;
      color: #2e7d32;
    }
  </style>

</head>

<body>

<header class="site-header">

  <nav class="nav container">

    <a
      href="index.html"
      class="logo"
    >
      SaBo
    </a>

  </nav>

</header>

<main class="auth-page">

  <section class="auth-card">

    <span class="section-label">
      SaBo Account
    </span>

    <h1>Create account</h1>

    <p class="auth-subtitle">
      Join SaBo and start selling and buying.
    </p>

    <div
      id="authMessage"
      class="auth-message"
      role="alert"
    ></div>

    <form id="signupForm">

      <div class="form-group">

        <label for="name">
          Full name
        </label>

        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="150"
          required
        >

      </div>

      <div class="form-group">

        <label for="email">
          Email
        </label>

        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
        >

      </div>

      <div class="form-group">

        <label for="password">
          Password
        </label>

        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        >

      </div>

      <div class="form-group">

        <label for="confirmPassword">
          Confirm password
        </label>

        <input
          id="confirmPassword"
          name="confirmPassword"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        >

      </div>

      <button
        id="signupButton"
        class="auth-submit"
        type="submit"
      >
        Create Account
      </button>

    </form>

    <p class="auth-link">
      Already have an account?
      <a href="login.html">
        Login
      </a>
    </p>

  </section>

</main>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="signup.js"></script>

</body>
</html>
